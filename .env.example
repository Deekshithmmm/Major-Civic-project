# Copy to .env and adjust. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://civic:civic_dev_password@localhost:5433/civic_accountability

# Anyone holding this can mint a session token for any official, of any role. The value below is
# usable for local development ONLY - startup refuses it whenever ENV is not "development".
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_dev_only_not_for_production
JWT_ALGORITHM=HS256
# Officials issue challans and open sealed evidence from these sessions, and the token sits in
# browser storage, so keep this in hours.
JWT_EXPIRE_MINUTES=60

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=civic_minio
S3_SECRET_KEY=civic_minio_password
S3_BUCKET_MEDIA=civic-media
S3_BUCKET_EVIDENCE_VAULT=civic-evidence-vault
S3_REGION=us-east-1

REDIS_URL=redis://localhost:6379/0

# Notification gateway abstraction — leave as "console" for local dev (logs instead of sending)
NOTIFICATION_PROVIDER=console
MSG91_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Every upload is processed in memory, so these cap what one request can allocate.
MAX_IMAGE_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=200

# Comma-separated list of allowed browser origins. Never "*" while credentials are allowed.
CORS_ORIGINS=http://localhost:5173

# Anything other than "development" enables the production guards: the API docs are not served,
# HSTS is sent, seeding refuses to run, and startup fails on a weak or default JWT_SECRET.
ENV=development
